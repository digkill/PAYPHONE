+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn app_limited_from_birth_keeps_ack_aggregation_bounded() {
+        let start = Instant::now();
+        let rtt = RttEstimator::new(Duration::from_millis(50));
+        let mut bbr = Bbr::new(Arc::new(BbrConfig::default()), 1200);
+        bbr.min_rtt = rtt.min();
+        for round in 0..100 {
+            let base = start + Duration::from_millis(round * 80);
+            for packet in 0..24 {
+                bbr.on_sent(
+                    base + Duration::from_millis(packet),
+                    1200,
+                    round * 24 + packet,
+                );
+            }
+            for packet in 0..24 {
+                let sent = base + Duration::from_millis(packet);
+                let acked = sent + Duration::from_millis(50);
+                bbr.on_ack(acked, sent, 1200, true, &rtt);
+                bbr.on_end_acks(acked, (23 - packet) * 1200, true, Some(round * 24 + packet));
+            }
+        }
+        assert!(bbr.max_bandwidth.get_estimate() > 0);
+        assert!(bbr.cwnd <= 2 * bbr.init_cwnd, "cwnd={}", bbr.cwnd);
+    }
+
+    #[test]
+    fn app_limited_startup_stops_growing_at_the_modeled_window() {
+        let mut bbr = Bbr::new(Arc::new(BbrConfig::default()), 1200);
+        bbr.acked_bytes = bbr.init_cwnd;
+        let target = bbr.get_target_cwnd(bbr.cwnd_gain);
+        bbr.cwnd = target;
+        for _ in 0..100 {
+            bbr.calculate_cwnd(1200, 0);
+        }
+        assert_eq!(bbr.cwnd, target);
+
+        // Startup grows gradually towards its model and never shrinks a
+        // previously larger window, including after an idle/application gap.
+        bbr.cwnd = target / 2;
+        bbr.calculate_cwnd(1200, 0);
+        assert_eq!(bbr.cwnd, target / 2 + 1200);
+        bbr.cwnd = target + 2400;
+        bbr.calculate_cwnd(1200, 0);
+        assert_eq!(bbr.cwnd, target + 2400);
+    }
+}
