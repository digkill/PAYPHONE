# Copy to .env and adjust as needed.
# .env is gitignored; this example file is the template.

# ---------------------------------------------------------
# payphone-server
# ---------------------------------------------------------

# Optional DNS upstream for the stub on 10.77.0.1:53 (default 1.1.1.1:53).
# PAYPHONE_DNS_UPSTREAM=1.1.1.1:53

# Session file so resume survives a server restart (default ./payphone-sessions.bin).
# PAYPHONE_SESSION_STORE=/app/state/sessions.bin

# TLS certificate + key (PEM or DER). Unset = generate/use
# dev-certs/payphone-cert.der and payphone-key.der (self-signed).
# PAYPHONE_TLS_CERT=/etc/letsencrypt/live/vpn.example.com/fullchain.pem
# PAYPHONE_TLS_KEY=/etc/letsencrypt/live/vpn.example.com/privkey.pem
# Comma-separated SANs written into a *generated* self-signed cert.
# PAYPHONE_TLS_SAN=localhost,vpn.example.com
#
# Let's Encrypt on TCP 443 (TLS-ALPN-01). DNS A-record must hit this
# host. Ignored if PAYPHONE_TLS_CERT is set to a custom path.
# Cache lives on the state volume in Docker (/app/state/acme).
# PAYPHONE_TLS_DOMAIN=vpn.example.com
# PAYPHONE_ACME_EMAIL=admin@vpn.example.com
# PAYPHONE_ACME_DIR=/app/state/acme
# PAYPHONE_ACME_STAGING=false
# PAYPHONE_AUTH_KEY=auth-keys/subscription-public.key

# Hex token_id per line. Re-read on each auth (mtime). Missing file = none revoked.
# PAYPHONE_REVOKE_FILE=auth-keys/revoked-token-ids.txt
#   cargo run -p payphone-token -- revoke subscription.token


# TCP listen for the HTTPS camouflage front (landing page for
# browsers, PAYPHONE frames for clients). Defaults to the UDP bind
# IP on port 40443 when unset. Set to `off` to disable.
# PAYPHONE_TCP_BIND_ADDR=127.0.0.1:40443

# REALITY (TCP 443 only). Default off: browsers still get the landing page.
# After `payphone-token reality-init`, keys + short-id live in auth-keys/.
# With PAYPHONE_TLS_DOMAIN set, that hostname still serves the landing page;
# other ClientHellos splice to dest.
# PAYPHONE_REALITY=off
# PAYPHONE_REALITY_DEST=www.microsoft.com:443
# PAYPHONE_REALITY_PRIVATE_KEY=auth-keys/reality-private.key
# PAYPHONE_REALITY_SHORT_ID=aabbccdd00112233

# ---------------------------------------------------------
# payphone-client
# ---------------------------------------------------------

# Address the client connects to.
# Bare-metal (cargo run): 127.0.0.1:40404
# Docker Compose: payphone-server:40404 (already set in docker-compose.yml)
PAYPHONE_SERVER_ADDR=127.0.0.1:40404

# quic (default, UDP) or tls (TCP HTTPS front). Aliases: udp, https, tcp.
PAYPHONE_TRANSPORT=quic

# Optional TCP override when the HTTPS front is not on the same
# host:port as PAYPHONE_SERVER_ADDR. If unset and the UDP port is
# 40404, the client uses 40443 automatically.
# PAYPHONE_TCP_SERVER_ADDR=127.0.0.1:40443

# TLS server name (SNI). Unset = hostname from PAYPHONE_SERVER_ADDR
# when that looks like a public DNS name, else localhost.
# PAYPHONE_SERVER_NAME=localhost
# Pin file (PEM or DER). Ignored as the sole trust source when
# PAYPHONE_TLS_CA=system (public CAs / Let's Encrypt).
# A public SNI implies system CAs unless you set PAYPHONE_TLS_CA=pin.
# PAYPHONE_TLS_PIN=dev-certs/payphone-cert.der
# PAYPHONE_TLS_CA=pin
# PAYPHONE_TOKEN=subscription.token
# PAYPHONE_SESSION_FILE=.payphone-session
# Optional REALITY on the TLS transport (ignored for quic).
# HMAC cert — no pin file required on this path.
# PAYPHONE_REALITY_PUBLIC_KEY=auth-keys/reality-public.key
# PAYPHONE_REALITY_SHORT_ID=aabbccdd00112233
# PAYPHONE_REALITY_SNI=www.microsoft.com
# PAYPHONE_CONFIG=payphone.toml

# Block all Internet except the VPN server while the client is running.
# If the tunnel drops, traffic stays blocked until you Ctrl+C.
# Default off.
# PAYPHONE_KILL_SWITCH=false

# ---------------------------------------------------------
# Wire obfuscation (both server and client)
# ---------------------------------------------------------

# Shared secret used to obfuscate every UDP datagram so it doesn't
# look like QUIC on the wire (see payphone-transport::obfuscation).
# Required — the process refuses to start without it. Must be
# IDENTICAL on server and client, and must NOT be this placeholder;
# generate a real secret per deployment, e.g.:
#   openssl rand -hex 32
PAYPHONE_OBFS_PSK=change-me-to-a-real-random-secret

# ---------------------------------------------------------
# Developer diagnostics (both server and client)
# ---------------------------------------------------------

# When true, logs every raw UDP datagram (size + sender) before
# obfuscation is even attempted. Off by default: staying silent
# about unrecognized traffic is part of the anti-DPI-probing model
# (see payphone-transport::obfuscated_socket). Turn on only while
# diagnosing connectivity issues.
PAYPHONE_DEV_MODE=false
