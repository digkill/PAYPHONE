# Copy to .env and adjust as needed.
# .env is gitignored; this example file is the template.

# ---------------------------------------------------------
# payphone-server
# ---------------------------------------------------------

# Optional DNS upstream for the stub on 10.77.0.1:53 (default 1.1.1.1:53).
# PAYPHONE_DNS_UPSTREAM=1.1.1.1:53

# Session file so resume survives a server restart (default ./payphone-sessions.bin).
# PAYPHONE_SESSION_STORE=/app/state/sessions.bin


# TCP listen for the HTTPS camouflage front (landing page for
# browsers, PAYPHONE frames for clients). Defaults to the UDP bind
# IP on port 40443 when unset. Set to `off` to disable.
# PAYPHONE_TCP_BIND_ADDR=127.0.0.1:40443

# ---------------------------------------------------------
# payphone-client
# ---------------------------------------------------------

# Address the client connects to.
# Bare-metal (cargo run): 127.0.0.1:40404
# Docker Compose: payphone-server:40404 (already set in docker-compose.yml)
PAYPHONE_SERVER_ADDR=127.0.0.1:40404

# quic (default, UDP) or tls (TCP HTTPS front). Aliases: udp, https, tcp.
PAYPHONE_TRANSPORT=quic

# Optional TCP override when the HTTPS front is not on the same
# host:port as PAYPHONE_SERVER_ADDR. If unset and the UDP port is
# 40404, the client uses 40443 automatically.
# PAYPHONE_TCP_SERVER_ADDR=127.0.0.1:40443

# ---------------------------------------------------------
# Wire obfuscation (both server and client)
# ---------------------------------------------------------

# Shared secret used to obfuscate every UDP datagram so it doesn't
# look like QUIC on the wire (see payphone-transport::obfuscation).
# Required — the process refuses to start without it. Must be
# IDENTICAL on server and client, and must NOT be this placeholder;
# generate a real secret per deployment, e.g.:
#   openssl rand -hex 32
PAYPHONE_OBFS_PSK=change-me-to-a-real-random-secret

# ---------------------------------------------------------
# Developer diagnostics (both server and client)
# ---------------------------------------------------------

# When true, logs every raw UDP datagram (size + sender) before
# obfuscation is even attempted. Off by default: staying silent
# about unrecognized traffic is part of the anti-DPI-probing model
# (see payphone-transport::obfuscated_socket). Turn on only while
# diagnosing connectivity issues.
PAYPHONE_DEV_MODE=false
