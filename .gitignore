# ============================================================
# Rust
# ============================================================

/target/
**/target/


# ============================================================
# PAYPHONE secrets / auth
# ============================================================

# Subscription signing keys (private key + everything else in the dir)
/auth-keys/*
**/auth-keys/*

# Public key is not sensitive (verify-only) and is baked into the
# server image by the Dockerfile, so it's tracked deliberately.
!/auth-keys/subscription-public.key

# Issued client subscription token
/subscription.token
**/subscription.token

# Saved PAYPHONE session / resume state
/.payphone-session
**/.payphone-session


# ============================================================
# TLS / QUIC dev certificates
# ============================================================

/dev-certs/
**/dev-certs/

*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.der


# ============================================================
# Environment / configuration secrets
# ============================================================

.env
.env.*
!.env.example

/payphone.toml
**/payphone.toml

*.secret
*.secrets


# ============================================================
